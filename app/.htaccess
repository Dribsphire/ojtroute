# Deny all access to application directory
# This directory contains sensitive PHP classes, services, and business logic

# Deny all HTTP access
Order Deny,Allow
Deny from all

# Block all file access
<FilesMatch ".*">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Block all files
<Files "*">
    Order Deny,Allow
    Deny from all
</Files>

# Custom error page
ErrorDocument 403 /ojtlast/public/403.php

# Security headers
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
