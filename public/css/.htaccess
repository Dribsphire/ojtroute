# Deny all direct access to CSS directory listing
Options -Indexes

# Custom error page
ErrorDocument 403 /ojtlast/public/403.php

# Allow access to CSS files only
<FilesMatch "\.css$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Block access to any other file types
<FilesMatch "^(?!.*\.css$).*$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable CORS for CSS files if needed
<IfModule mod_headers.c>
    <FilesMatch "\.css$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
