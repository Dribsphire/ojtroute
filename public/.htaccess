# Security Headers and Configuration
# Generated based on Security Scan Report

<IfModule mod_headers.c>
    # 1. HSTS (High Severity)
    # Strictly enforce HTTPS for 1 year, include subdomains
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 2. X-Frame-Options (Medium)
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # 3. X-Content-Type-Options (Medium)
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # 4. Permissions-Policy (Low)
    # Restrict browser features
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"

    # 5. Referrer-Policy (Low)
    # Control referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 6. Hide X-Powered-By (Low)
    # Hide PHP version
    Header unset X-Powered-By

    # 7. Cross-Origin-Opener-Policy (Low)
    # Protect window interactions
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # 8. Cross-Origin-Resource-Policy (Low)
    # Restrict resource loading
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # 9. Content Security Policy (Medium)
    # Whitelist trusted sources for scripts, styles, images, and fonts
    # Adapted for: Bootstrap, FontAwesome, Google Fonts, Leaflet, and internal assets
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https://raw.githubusercontent.com https://*.tile.openstreetmap.org https://unpkg.com https://cdnjs.cloudflare.com; connect-src 'self' https://unpkg.com;"

    # Cookie Security via Headers (Fallback if php_value doesn't work)
    # Append Secure if missing
    Header edit Set-Cookie "^((?!;\s?Secure).)+$" "$0; Secure"
    # Append HttpOnly if missing
    Header edit Set-Cookie "^((?!;\s?HttpOnly).)+$" "$0; HttpOnly"
    # Append SameSite=Lax if missing
    Header edit Set-Cookie "^((?!;\s?SameSite).)+$" "$0; SameSite=Lax"
</IfModule>

# PHP Session Configuration
# Sets secure defaults for sessions
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite "Lax"
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
    # Prevent JavaScript access to session ID
    php_value session.cookie_httponly 1
</IfModule>

# Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>
