# Deny all direct access to JavaScript directory listing
Options -Indexes

# Custom error page
ErrorDocument 403 /ojtlast/public/403.php

# Allow access to JavaScript files only
<FilesMatch "\.js$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Block access to any other file types
<FilesMatch "^(?!.*\.js$).*$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable CORS for JavaScript files if needed
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
