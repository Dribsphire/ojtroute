# Protect storage directory
# Allow only specific file types to be accessed

# Prevent directory listing
Options -Indexes

# Deny access by default
Order Deny,Allow
Deny from all

# Allow access only to uploaded images and documents
<FilesMatch "\.(jpg|jpeg|png|gif|webp|pdf)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block access to PHP files in storage
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Custom error page
ErrorDocument 403 /ojtlast/public/403.php

# Security headers for allowed files
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|pdf)$">
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
    </FilesMatch>
</IfModule>
