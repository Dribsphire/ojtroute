<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Handle Google Verification File (Rewrite root request to public folder)
    RewriteRule ^(google[a-zA-Z0-9]+\.html)$ public/$1 [L]

    # 2. Handle Robots and Sitemap
    RewriteRule ^robots\.txt$ public/robots.txt [L]
    RewriteRule ^sitemap\.xml$ public/sitemap.xml [L]

    # 3. Forward all other traffic to public/ index
    # This ensures the site loads correctly from the root URL
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
